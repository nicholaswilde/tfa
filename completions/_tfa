#compdef tfa

autoload -U is-at-least

_tfa() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_tfa_commands" \
"*::: :->tfa" \
&& ret=0
    case $state in
    (tfa)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tfa-command-$line[1]:"
        case $line[1] in
            (generate)
_arguments "${_arguments_options[@]}" : \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'-c[Copy generated token to clipboard]' \
'--copy[Copy generated token to clipboard]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':account -- Name of the account:_default' \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
'-d+[Number of digits in generated code (e.g. 6 or 8)]:DIGITS:_default' \
'--digits=[Number of digits in generated code (e.g. 6 or 8)]:DIGITS:_default' \
'-p+[Time step period in seconds (e.g. 30 or 60)]:PERIOD:_default' \
'--period=[Time step period in seconds (e.g. 30 or 60)]:PERIOD:_default' \
'-a+[Hash algorithm (sha1, sha256, sha512)]:ALGORITHM:_default' \
'--algorithm=[Hash algorithm (sha1, sha256, sha512)]:ALGORITHM:_default' \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':account -- Name of the account:_default' \
'::secret -- TOTP secret key or otpauth\:// URI (prompted if omitted):_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':account -- Name of the account:_default' \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'-r[Print only the raw secret or URI]' \
'--raw[Print only the raw secret or URI]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':account -- Name of the account:_default' \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
'--password=[Master passphrase for encryption (prompted securely if omitted)]:PASSWORD:_default' \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'--unencrypted[Export without encryption (plain JSON)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'::file -- Destination backup file path (prints to stdout if omitted):_files' \
&& ret=0
;;
(import)
_arguments "${_arguments_options[@]}" : \
'--password=[Master passphrase for encrypted backup (prompted securely if omitted)]:PASSWORD:_default' \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'--dry-run[Preview accounts to import without saving them]' \
'(--skip)--overwrite[Overwrite existing accounts if conflicts occur]' \
'(--overwrite)--skip[Skip existing accounts if conflicts occur (default)]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':file_or_payload -- Path to backup file or raw payload string:_default' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--storage=[Credential storage backend]:STORAGE:((auto\:"Attempt OS keyring first; fallback to local file store if unavailable"
keyring\:"Strictly use system keyring (Secret Service, Keychain, Credential Manager)"
file\:"Use local file storage (~/.local/share/tfa/credentials.json)"))' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
':shell -- Shell to generate completions for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_tfa__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tfa-help-command-$line[1]:"
        case $line[1] in
            (generate)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(add)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(show)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(export)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(import)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_tfa_commands] )) ||
_tfa_commands() {
    local commands; commands=(
'generate:Generate a TOTP token for an account' \
'add:Add a new account secret or OTPAuth URL' \
'list:List all stored accounts' \
'delete:Delete an account secret' \
'show:Show account details and stored secret' \
'export:Export accounts to an encrypted backup file or stdout' \
'import:Import accounts from a backup file, migration URI, or JSON payload' \
'completions:Generate shell autocompletions script' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'tfa commands' commands "$@"
}
(( $+functions[_tfa__subcmd__add_commands] )) ||
_tfa__subcmd__add_commands() {
    local commands; commands=()
    _describe -t commands 'tfa add commands' commands "$@"
}
